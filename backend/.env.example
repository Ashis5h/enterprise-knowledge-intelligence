# ── Core ─────────────────────────────────────────────────────────────────────
APP_NAME="Enterprise Knowledge Intelligence Platform"
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose default — change host/port for RDS or a remote Postgres.
DATABASE_URL=postgresql+psycopg://eki:eki_password@localhost:5432/eki

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this to a long random string in production.
JWT_SECRET_KEY=change-this-demo-secret
JWT_EXPIRATION_MINUTES=480

# ── LLM provider ─────────────────────────────────────────────────────────────
# "local"  — grounded sentence extraction, no API key needed
# "ollama" — local Ollama server (recommended for free local LLM)
# "openai" — OpenAI-compatible API (OpenAI, Groq, Together AI, etc.)
LLM_PROVIDER=local
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# "local-hash" is a fast offline model for demos.
# For Pinecone, a real sentence-transformer is auto-selected unless you override here.
EMBEDDING_MODEL=local-hash
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector database ───────────────────────────────────────────────────────────
# "chroma" (default) stores vectors locally.
# "pinecone" sends vectors to Pinecone — requires PINECONE_API_KEY.
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_store

# Pinecone — only needed when VECTOR_DB_PROVIDER=pinecone
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX_NAME=enterprise-knowledge
# PINECONE_NAMESPACE=enterprise-documents
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_DIMENSION=384           # must match your embedding model output size
# PINECONE_CREATE_INDEX=false      # set true once to create the index, then back to false
# PINECONE_EMBEDDING_MODEL=all-MiniLM-L6-v2
